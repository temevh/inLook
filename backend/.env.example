# Copy to .env and start with `uvicorn app.main:app --env-file .env`. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Seconds per Gemini attempt, attempts per call, and seconds a claim gets to reach a verdict.
GEMINI_TIMEOUT_S=20
GEMINI_ATTEMPTS=2
CHECK_TIMEOUT_S=45
ELEVENLABS_API_KEY=
# MongoDB Atlas: facts, reviews, strategies and the event log. Leave empty to run on the in-memory log.
MONGODB_URI=
MONGODB_DB=inlook
# Milliseconds a MongoDB call waits for Atlas before failing; seconds the startup check waits.
MONGODB_TIMEOUT_MS=15000
MONGODB_STARTUP_TIMEOUT_S=10
# Enables POST /dev/events (inject SSE events while building the overlay)
INLOOK_DEV=1
# Context.dev: scrape and search for every source re-check, monitors for page watching.
CONTEXT_DEV_API_KEY=
# Public URL of this backend (tunnel) so Context.dev monitors can call POST /webhooks/context.
PUBLIC_BASE_URL=
