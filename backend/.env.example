# Copy to .env and start with `uvicorn app.main:app --env-file .env`. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds per Gemini attempt, attempts per call, and seconds a claim gets to reach a verdict.
GEMINI_TIMEOUT_S=20
GEMINI_ATTEMPTS=2
CHECK_TIMEOUT_S=45
ELEVENLABS_API_KEY=
# Mic path: ElevenLabs realtime STT model (scribe_v3_live is the only one with speaker labels), language,
# and the pause in seconds that ends a transcript line.
ELEVENLABS_MODEL=scribe_v3_live
STT_LANGUAGE=en
STT_VAD_SILENCE_S=0.8
# Names for the speakers, in the order they first speak; more speakers become "Speaker N".
INLOOK_SPEAKERS=Mira Mockwell,Sam Sample
# Lines go to Gemini spot in batches this many seconds after the first; with SPOT_PREFILTER=1 only lines with
# a number, a currency or a word from a stored fact are sent (saves Gemini quota).
SPOT_DEBOUNCE_S=1.5
SPOT_PREFILTER=1
# MongoDB Atlas: facts, reviews, strategies and the event log. Leave empty to run on the in-memory log.
MONGODB_URI=
MONGODB_DB=inlook
# Milliseconds a MongoDB call waits for Atlas before failing; seconds the startup check waits.
MONGODB_TIMEOUT_MS=15000
MONGODB_STARTUP_TIMEOUT_S=10
# Enables POST /dev/events (inject SSE events while building the overlay)
INLOOK_DEV=1
# Context.dev: scrape and search for every source re-check, monitors for page watching.
CONTEXT_DEV_API_KEY=
# Public URL of this backend (tunnel) so Context.dev monitors can call POST /webhooks/context.
PUBLIC_BASE_URL=
