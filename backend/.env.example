# Copy to .env and start with `uvicorn app.main:app --env-file .env`. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=
# MongoDB Atlas: facts, reviews, strategies and the event log. Leave empty to run on the in-memory log.
MONGODB_URI=
MONGODB_DB=inlook
# Milliseconds a MongoDB call waits for Atlas before failing (default 5000).
MONGODB_TIMEOUT_MS=5000
# Enables POST /dev/events (inject SSE events while building the overlay)
INLOOK_DEV=1
# Context.dev: scrape and search for every source re-check, monitors for page watching.
CONTEXT_DEV_API_KEY=
# Public URL of this backend (tunnel) so Context.dev monitors can call POST /webhooks/context.
PUBLIC_BASE_URL=
