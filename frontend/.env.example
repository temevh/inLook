# MongoDB Atlas connection string, including the database name (inlook) in the path.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/inlook?retryWrites=true&w=majority"
PORT=3001

# Dashboard dev proxy targets (optional; these are the defaults)
# INLOOK_API_URL=http://127.0.0.1:3001
# INLOOK_BACKEND_URL=http://127.0.0.1:8000
# Signed-in employee until there is a login (person id), e.g. p-sam. Default: p-ada.
# VITE_INLOOK_USER=p-ada
