{
  "name": "inlook-overlay",
  "version": "0.0.0",
  "private": true,
  "description": "inLook overlay: Electron HUD + widget for Debian X11",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron . --ozone-platform=x11 --enable-transparent-visuals",
    "gen:contract": "node scripts/gen-contract.mjs ts",
    "gen:contract:py": "node scripts/gen-contract.mjs py",
    "mock": "node scripts/mock.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/rethink-sans": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eventsource": "^5.1.5"
  }
}
